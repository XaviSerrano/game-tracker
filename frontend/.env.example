# Credenciales de IGDB (Twitch Developer Console)
IGDB_CLIENT_ID="your_igdb_client_id"
IGDB_CLIENT_SECRET="your_igdb_client_secret"

# Cadena de conexión a PostgreSQL (Express usa esto en frontend/server/db.ts)
# Local: postgresql://usuario:password@localhost:5432/gametracker
# Render: copia el "Internal/External Connection String" de tu base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gametracker"
