# PostgreSQL. Never expose this connection string to the browser.
DATABASE_URL=postgresql://localhost:5432/gametracker

# Twitch Developer Console credentials used by IGDB.
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Required in production for password-reset links.
PUBLIC_APP_URL=http://localhost:3000

# Optional SMTP configuration. Without it, local reset links are returned for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GameTracker <no-reply@gametracker.local>

# Optional; defaults to 3001.
PORT=3001
