# PostgreSQL. Never expose this connection string to the browser.
DATABASE_URL=

# Twitch Developer Console credentials used by IGDB.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Google OAuth web client ID (also set as VITE_GOOGLE_CLIENT_ID in frontend).
GOOGLE_CLIENT_ID=

# Required in production for password-reset links.
PUBLIC_APP_URL=

# Comma-separated account IDs allowed to moderate roadmap suggestions.
# Keep empty locally unless you explicitly want to grant this privilege.
ROADMAP_MODERATOR_USER_IDS=

# Optional SMTP configuration. Without it, local reset links are returned for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional; defaults to 3001.
PORT=3001
